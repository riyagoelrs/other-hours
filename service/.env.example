# Server-side only. Load with: node --env-file=service/.env service/server.mjs
PORT=4174
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://riyagoelrs.github.io
RATE_LIMIT_PER_MINUTE=30
# Optional official YouTube Data API key; retrieves descriptions, not transcripts.
YOUTUBE_DATA_API_KEY=
# An operator-controlled service with authorized access. Must return {authorized:true,text:...}.
AUTHORIZED_TRANSCRIPT_ENDPOINT=
TRANSCRIPT_SERVICE_TOKEN=
# Optional absolute path to a module exporting analyze({evidence,hobbies,materialNames}).
# Its output must satisfy the structured, source-grounded contract in service/README.md.
ANALYZER_MODULE=
